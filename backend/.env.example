# Backend Environment Example
# Copy this file to .env and fill in the real values.

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/pharmstore

# JWT secret key (keep this long & random in production)
SECRET=replace_with_a_long_random_secret

# CORS Allowed Origins (choose ONE method below)
# Option A: Single frontend origin
# FRONTEND_ORIGIN=http://localhost:5173
# Option B: Multiple origins (comma separated)
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional cookie domain (e.g. .example.com) - leave unset for localhost
# COOKIE_DOMAIN=.example.com

# Debug request logging (set to 1 to enable)
# DEBUG_REQ=1
